{
  "editor.tabSize": 2,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "bottom",
  "editor.minimap.enabled": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {},
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "diffEditor.renderSideBySide": false,
  "diffEditor.ignoreTrimWhitespace": true,
  "workbench.layoutControl.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Bearded Theme OLED (Experimental)",
  "workbench.startupEditor": "none",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.defaultProfile.osx": "fish",
  "files.autoGuessEncoding": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**/": true,
    "**/.hg/store/**": true,
    "**/venv/**": true,
    "**/.venv/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true
  },
  "window.commandCenter": true,
  "window.nativeTabs": true,
  "window.customTitleBarVisibility": "never",
  "window.titleBarStyle": "native",
  "chat.viewSessions.orientation": "stacked",
  "chat.includeApplyingInstructions": true,
  "chat.includeReferencedInstructions": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.autoReveal": false,
  "remote.autoForwardPortsSource": "hybrid",
  "remote.SSH.useLocalServer": false,
  "remote.SSH.remotePlatform": {
    "lab": "linux",
    "home": "linux"
  },
  // ================================================================
  "git.autofetch": true,
  "git.confirmSync": false,
  "githubIssues.queries": [
    {
      "label": "My Issues",
      "query": "is:open assignee:${user} repo:${owner}/${repository}",
      "groupBy": [
        "milestone"
      ]
    },
    {
      "label": "Created Issues",
      "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
    },
    {
      "label": "Recent Issues",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc"
    }
  ],
  // ================================================================
  "[python]": {},
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "jupyter.interactiveWindow.creationMode": "perFile",
  // ================================================================
  "[javascript]": {},
  "[typescript]": {},
  "[typescriptreact]": {},
  "js/ts.preferences.renameMatchingJsxTags": true,
  "js/ts.autoClosingTags.enabled": true,
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": false,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": false,
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.variableTypes.enabled": true,
  "eslint.useESLintClass": true,
  "biome.suggestInstallingGlobally": false,
  "prettier.useEditorConfig": false,
  // "prettier.resolveGlobalModules": true,
  // "prettier.prettierPath": "/Users/tf63/.volta/tools/image/packages/prettier/lib/node_modules/prettier/",
  // ================================================================
  "go.inlayHints.ignoredError": true,
  "go.inlayHints.assignVariableTypes": true,
  "go.inlayHints.constantValues": true,
  "go.inlayHints.functionTypeParameters": true,
  "go.inlayHints.parameterNames": true,
  "go.inlayHints.compositeLiteralFields": true,
  "go.inlayHints.compositeLiteralTypes": true,
  "go.inlayHints.rangeVariableTypes": true,
  "gopls": {
    "ui.newGoFileHeader": false
  },
  // ================================================================
  "hediet.vscode-drawio.theme": "Kennedy",
  "hediet.vscode-drawio.resizeImages": null,
  "bracket-pair-colorizer-2.depreciation-notice": false,
  "markdown.marp.enableHtml": true,
  "markdown.marp.mathTypesetting": "katex", // or mathjax (katexだと\bmが使える)
  "markdown.marp.themes": [
    "./theme/lab.css"
  ],
  "markdown.copyFiles.destination": {
    // https://code.visualstudio.com/updates/v1_79#_copy-external-media-files-into-workspace-on-drop-or-paste-for-markdown
    "*.md": "${documentDirName}/img/${documentBaseName}.png",
    "*.mdx": "${documentDirName}/img/${documentBaseName}.png"
  },
  "tailwindCSS.includeLanguages": {
    "erb": "html"
  },
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true
  }
}
