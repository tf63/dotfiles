{
  "mode": "allowlist",
  "rules": [
    { "command": "ls" },
    { "command": "tree" },
    { "command": "grep" },
    { "command": "xargs grep" },
    { "command": "touch" },
    { "command": "cp", "include": ["-n"] },
    { "command": "echo" },
    { "command": "sed", "include": ["-n"] },
    { "command": "mv" },
    { "command": "mkdir" },
    { "command": "find", "exclude": ["-exec"] },
    { "command": "head" },
    { "command": "tail" },
    { "command": "pwd" },
    { "command": "wc", "include": ["-l"] },
    { "command": "trash" },
    { "command": "git diff" },
    { "command": "git log" },
    { "command": "git show" },
    { "command": "git branch", "include": ["-a"] },
    { "command": "gh pr view" },
    { "command": "gh pr diff" },
    { "command": "gh pr list" },
    { "command": "gh pr edit" },
    { "command": "gh pr create", "include": ["--body-file"] },
    { "command": "gh pr review", "include": ["--body-file", "--comment"] },
    { "command": "gh pr comment" },
    { "command": "gh api" }
  ]
}
